<h1><%- title %></h1>

<%- messages() %> <% if (errors) { %>
<ul class="error-list">
  <% errors.array().forEach(error => { %>
  <li><%= error.msg %></li>
  <% }) %>
</ul>
<% } %>

<h2>Welcome <%= accountData.account_firstname %></h2>

<p>
  <a href="/account/update/<%= accountData.account_id %>"
    >Update Account Information</a
  >
</p>

<h3>My Favorites</h3>
<p><a href="/favorites/">View My Saved Vehicles</a> <span class="heart-icon filled">&hearts;</span></p>

<% if (accountData.account_type === "Employee" || accountData.account_type ===
"Admin") { %>
<h3>Inventory Management</h3>
<p><a href="/inv/">Manage Inventory</a></p>
<% } %>
