<h1><%- title %></h1>

<p class="notice-text">Provide a correct classification name.</p>

<%- messages() %>

<% if (errors) { %>
  <ul class="error-list">
  <% errors.array().forEach(error => { %>
    <li><%= error.msg %></li>
  <% }) %>
  </ul>
<% } %>

<div class="form-container">
  <p class="form-instructions">FIELD IS REQUIRED.</p>

  <form id="addClassificationForm" action="/inv/add-classification" method="post">
    <div class="form-group">
      <label for="classification_name">Classification Name</label>
      <p class="input-help-white">NAME MUST BE ALPHABETIC CHARACTERS ONLY.</p>
      <input
        type="text"
        id="classification_name"
        name="classification_name"
        required
        value="<%= locals.classification_name || '' %>">
    </div>

    <div class="form-group">
      <button type="submit" class="btn-primary">Add Classification</button>
    </div>
  </form>
</div>
