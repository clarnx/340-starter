<h1><%- title %></h1>

<%- messages() %> <% if (errors) { %>
<ul class="error-list">
  <% errors.array().forEach(error => { %>
  <li><%= error.msg %></li>
  <% }) %>
</ul>
<% } %>

<h2>Update Account Information</h2>
<form id="updateAccountForm" action="/account/update" method="post">
  <div class="form-group">
    <label for="account_firstname">First Name</label>
    <input
      type="text"
      id="account_firstname"
      name="account_firstname"
      required
      value="<%= locals.account_firstname %>"
    />
  </div>

  <div class="form-group">
    <label for="account_lastname">Last Name</label>
    <input
      type="text"
      id="account_lastname"
      name="account_lastname"
      required
      value="<%= locals.account_lastname %>"
    />
  </div>

  <div class="form-group">
    <label for="account_email">Email Address</label>
    <input
      type="email"
      id="account_email"
      name="account_email"
      required
      value="<%= locals.account_email %>"
    />
  </div>

  <input type="hidden" name="account_id" value="<%= locals.account_id %>" />

  <div class="form-group">
    <button type="submit" class="btn-primary">Update Account</button>
  </div>
</form>

<h2>Change Password</h2>
<form id="changePasswordForm" action="/account/update-password" method="post">
  <p class="password-requirements">
    <strong>Note:</strong> Entering a new password will replace your current
    password. Password must be at least 12 characters and contain at least 1
    capital letter, 1 number, and 1 special character (!@#$%^&*).
  </p>

  <div class="form-group">
    <label for="account_password">New Password</label>
    <input
      type="password"
      id="account_password"
      name="account_password"
      required
      pattern="^(?=.*[A-Z])(?=.*[0-9])(?=.*[!@#$%^&*])[A-Za-z\d!@#$%^&*]{12,}$"
    />
  </div>

  <input type="hidden" name="account_id" value="<%= locals.account_id %>" />

  <div class="form-group">
    <button type="submit" class="btn-primary">Change Password</button>
  </div>
</form>
